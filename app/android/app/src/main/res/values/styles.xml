<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Démarrage : fond sombre Lyra Night et logo (pas de flash blanc) -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/lyra_bg</item>
    </style>
    <style name="LockTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/lyra_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/lyra_ink</item>
    </style>
</resources>
