<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ : ecran de demarrage systeme avec le symbole R-vinyle -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/lyra_bg</item>
        <item name="android:windowSplashScreenBackground">@color/lyra_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/lyra_ink</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/lyra_bg</item>
    </style>
</resources>
