<?xml version="1.0" encoding="utf-8"?>
<!-- Widget compact LyraMusic (4 × 1) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">
        <ImageView
            android:id="@+id/widget_art"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop"
            android:src="@drawable/widget_art_bg" />
        <ImageView
            android:id="@+id/widget_art_placeholder"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_stat_lyra"
            android:tint="@color/widget_text" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text2"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_prev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/previous"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_w_prev"
        android:tint="@color/widget_text" />
    <ImageButton
        android:id="@+id/widget_play"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/widget_play_bg"
        android:contentDescription="@string/play"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_w_play"
        android:tint="@color/widget_on_play" />
    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@android:color/transparent"
        android:contentDescription="@string/next"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_w_next"
        android:tint="@color/widget_text" />
</LinearLayout>
